[Desktop Entry]
# This is the spec version, *not* the application version
Version=1.1
Type=Application
Name=Psi
GenericName=XMPP Client
Comment=Communicate over the XMPP network
Icon=psi
Exec=psi %U
MimeType=x-scheme-handler/xmpp;
Terminal=false
X-KDE-StartupNotify=true
StartupWMClass=Psi
Categories=Network;InstantMessaging;Qt;
Keywords=XMPP;Jabber;chat;instant messaging;messenger;IM;VoIP;calls;file sharing;
Actions=SelectProfile;QuitApplication;

# Translations
GenericName[nl]=XMPP-client
Comment[nl]=Communiceer via het XMPP-netwerk
Keywords[nl]=XMPP;Jabber;Psi;chat;instantberichten;messenger;IM;VoIP;gesprekken;bestandsdeling;
Icon[nl]=psi-plus
Name[nl]=Psi+
