Icon[eo]=psi-plus
Keywords[eo]=XMPP;Jabber;Psi;babilejo;tujmesaĝoj;tujmesaĝilo;IM;VoIP;vokoj;kunhavigado de dosieroj;
Name[eo]=Psi+
